[
  {
    "start": 0.3,
    "end": 6.563,
    "text": "Se o seu telefone fixo tocar de madrugada e ninguém responder do outro lado,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 6.563,
    "end": 7.47,
    "text": "não atenda.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 7.47,
    "end": 8.706,
    "text": "Mas se atender,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 8.706,
    "end": 9.86,
    "text": "não diga nada.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 10.26,
    "end": 14.871,
    "text": "Todo mundo acha que um telefone mudo é só defeito na linha.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 14.871,
    "end": 15.34,
    "text": "Não é.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 15.74,
    "end": 16.42,
    "text": "Em 1987,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 16.42,
    "end": 21.092,
    "text": "a família mandou cortar a linha de uma casa abandonada.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 21.092,
    "end": 23.896,
    "text": "Mas o telefone continuou tocando,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 23.896,
    "end": 25.34,
    "text": "às três da manhã.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 25.74,
    "end": 26.7,
    "text": "A vizinha,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 26.7,
    "end": 27.852,
    "text": "Dona Eunice,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 27.852,
    "end": 29.388,
    "text": "atendeu uma vez.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 29.388,
    "end": 32.172,
    "text": "Ouviu uma respiração lenta e,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 32.172,
    "end": 32.844,
    "text": "depois,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 32.844,
    "end": 35.34,
    "text": "o próprio nome sussurrado.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 35.74,
    "end": 38.384,
    "text": "Ela anotou o número no caderno.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 38.384,
    "end": 39.408,
    "text": "Não existia.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 39.408,
    "end": 42.82,
    "text": "Mas o código de área era o da casa dela.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 43.22,
    "end": 45.269,
    "text": "Três noites depois,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 45.269,
    "end": 47.964,
    "text": "o telefone tocou de novo.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 47.964,
    "end": 49.043,
    "text": "Dessa vez,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 49.043,
    "end": 51.307,
    "text": "a voz falou baixinho:",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 51.307,
    "end": 53.14,
    "text": "ainda não é hora.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 53.54,
    "end": 56.898,
    "text": "Ninguém sabe quem é a moça do telefone mudo.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 56.898,
    "end": 61.02,
    "text": "Só se sabe que ela liga para quem já ouviu a voz dela.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 61.42,
    "end": 62.879,
    "text": "Na última ligação,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 62.879,
    "end": 66.282,
    "text": "a voz era de uma mulher de vestido branco,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 66.282,
    "end": 68.308,
    "text": "sentada na beira da cama,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 68.308,
    "end": 70.82,
    "text": "com o fone encostado no ouvido.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 71.22,
    "end": 73.504,
    "text": "Se tocar de madrugada,",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 73.504,
    "end": 74.645,
    "text": "não atenda.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 74.645,
    "end": 77.033,
    "text": "E se você já atendeu...",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  },
  {
    "start": 77.033,
    "end": 79.42,
    "text": "ela já sabe o seu nome.",
    "timing": "estimated_proportional_to_characters_realign_before_approval"
  }
]